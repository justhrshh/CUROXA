# Copy to .env and fill with real values. Never commit .env.
PORT=5000

# REQUIRED — high-entropy random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_long_random_hex_string

# Canonical public frontend application URL (used for password reset, email links, invitations)
FRONTEND_URL=http://localhost:3000
# Optional override for public base URL:
# PUBLIC_APP_URL=https://yourdomain.com

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# MongoDB connection string (use a least-privilege DB user).
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/medicore

# Google OAuth Client ID (public, safe for frontend too).
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Node environment: "production" disables the simulated Google login backdoor.
NODE_ENV=development

# Optional: allow the default admin seed in production (NOT recommended).
# SEED_DEFAULT_ADMIN=false

# SMTP Mail Server Configuration for password recovery OTP emails
# For Mailtrap (Development):
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your_mailtrap_username
# SMTP_PASS=your_mailtrap_password
# SMTP_SECURE=false

# For Gmail (Production):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your_gmail_address@gmail.com
# SMTP_PASS=your_gmail_app_password
# SMTP_SECURE=true
# SMTP_FROM="MediCore Security" <your_gmail_address@gmail.com>

# OR use an HTTP email API key (highly recommended for bypassing Render Free tier SMTP restrictions):
# BREVO_API_KEY=your_brevo_api_key
# SENDGRID_API_KEY=your_sendgrid_api_key
# RESEND_API_KEY=re_your_api_key

# Cloudflare R2 Object Storage (For Compliance & Medical Documents)
# STORAGE_DRIVER: "r2" in production/staging, "local" for local offline testing
STORAGE_DRIVER=local
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_PUBLIC=quroxa-public-assets
R2_BUCKET_PRIVATE=quroxa-private-vault
R2_BUCKET_NAME=medicore-uploads
R2_PUBLIC_DOMAIN=https://pub-your_id.r2.dev

# PING4SMS Configuration (Transactional Route 2 DLT OTP Gateway)
PING4SMS_API_KEY=your_ping4sms_api_key
PING4SMS_TEMPLATE_ID=1507165967974501361
PING4SMS_SENDER_ID=PNGOTP
PING4SMS_ROUTE=2
PING4SMS_API_URL=https://site.ping4sms.com/api/smsapi

