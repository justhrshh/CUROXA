# Copy to .env and fill with real values. Never commit .env.
# Only variables prefixed with VITE_ are exposed to the browser bundle,
# so NEVER put a secret here. Google web Sign-In needs only the Client ID.

# Backend API base URL. Set to your deployed API in production.
VITE_API_URL=https://curoxa.onrender.com/api

# Google OAuth Client ID (public by design).
VITE_GOOGLE_CLIENT_ID=333791894510-1usbjtrdpj3137bl7b8hpk895d5lhqca.apps.googleusercontent.com
